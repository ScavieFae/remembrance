{
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/memory.py\" load"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/memory.py\" prompt"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/log-compaction.py"
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/log-compaction.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/memory.py\" save"
          }
        ]
      }
    ]
  }
}
